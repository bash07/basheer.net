# ============================================================
# Copy this file to .env on the GCP VM and fill in values.
# Run: cp .env.example .env && nano .env
# NEVER commit .env to git!
# ============================================================

# ── LLM Provider — Primary Tier ──────────────────────────
# Used for quality-critical tasks: blog research, writing, editing.
# Select backend: gemini | openrouter | openai-compat
LLM_PROVIDER=gemini

# Model name for the chosen provider:
#   gemini:        gemini-2.5-pro  /  gemini-2.0-flash
#   openrouter:    anthropic/claude-3-5-sonnet  /  meta-llama/llama-3.3-70b-instruct
#   openai-compat: gpt-4o  /  llama3-70b-8192 (Groq)
LLM_MODEL=gemini-2.0-flash

# ── LLM Provider — Nano Tier ─────────────────────────────
# Used for: chat assistant (plain text replies only).
# Falls back to the primary tier if not set — safe to leave blank.
# LLM_NANO_PROVIDER defaults to LLM_PROVIDER if left empty.
#
# ⚠️  The nano model MUST support function calling (tool_choice).
#     Most :free models do NOT. Use a paid/named model without :free suffix,
#     or a provider with confirmed function-calling support (e.g. Groq, Gemini Flash).
#
# LLM_NANO_PROVIDER=openrouter
# LLM_NANO_MODEL=meta-llama/llama-3.1-8b-instruct   # no :free suffix

# ── LLM Provider — Fallback Tier ─────────────────────────
# Automatically used when the primary model returns a transient error
# (503 overloaded, 429 rate-limited, 524 timeout, 502 bad gateway).
# The pipeline retries once with this model, then raises if it also fails.
# Leave blank to disable auto-failover (error surfaces immediately).
# LLM_FALLBACK_PROVIDER defaults to LLM_PROVIDER if left empty.
#
# Example: primary=gemini (free), fallback=openrouter paid model
# LLM_FALLBACK_PROVIDER=openrouter
# LLM_FALLBACK_MODEL=anthropic/claude-3-5-haiku
#
# Example: different gemini model as fallback
# LLM_FALLBACK_MODEL=gemini-2.0-flash

# Fill in only the key for your chosen provider:
GEMINI_API_KEY=your-gemini-api-key-here      # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=sk-or-your-key-here     # https://openrouter.ai/keys

# For openai-compat only — uncomment ONE pair and fill in your key:
#
# OpenAI (https://platform.openai.com/api-keys)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key-here
#
# Groq (https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your-groq-key-here
#
# Local Ollama (no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# ── GitHub (blog module) ──────────────────────────────────
# Fine-grained PAT: Settings → Developer → Tokens
# Permissions needed: contents:write on bash07/basheer.net
GITHUB_TOKEN=github_pat_your-token-here
GITHUB_REPO=bash07/basheer.net

# ── Telegram Bot ─────────────────────────────────────────
# Create via @BotFather → /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Your personal Telegram user ID (NOT chat ID of the bot)
# Get it: message @userinfobot on Telegram
TELEGRAM_CHAT_ID=987654321

# ── REST API Security ─────────────────────────────────────
# Random secret for the /generate webhook endpoint
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=change-this-to-a-random-secret

# ── General ───────────────────────────────────────────────
GENERIC_TIMEZONE=Asia/Kolkata
